    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.93.2",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
